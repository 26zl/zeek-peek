# --- SSH connection to the host that runs Zeek ---
# REQUIRED. Hostname or IP. Can be an alias from your ~/.ssh/config.
SSH_HOST=
# Default 22.
SSH_PORT=22
# REQUIRED. SSH username on the remote host.
SSH_USER=
# Path to the private key. ~ is expanded. May be omitted if you rely on ssh-agent.
SSH_KEY_PATH=~/.ssh/id_ed25519
# Optional passphrase for the key. Leave empty if the key is in ssh-agent.
SSH_KEY_PASSPHRASE=

# --- Host key verification ---
# Path to a known_hosts file. If empty, the system known_hosts is loaded.
SSH_KNOWN_HOSTS=

# --- Timeouts ---
SSH_CONNECT_TIMEOUT=10

# --- Zeek logs ---
# Directory on the remote host that holds the live *.log files.
ZEEK_LOG_PATH=/var/spool/zeek/zeek
# Comma-separated list of log names that show up as tabs in the UI.
KNOWN_LOGS=conn,dns,http,ssl,ssh,dhcp,notice,files

# --- Limits ---
DEFAULT_LIMIT=100
MAX_LIMIT=10000
TAIL_BYTES=524288
MAX_TAIL_BYTES=8388608

# --- Caching (seconds) ---
STATUS_CACHE_TTL=5
LOG_CACHE_TTL=2

# --- Concurrency ---
# Number of concurrent SSH operations. The connection is reused, so 1 is fine.
MAX_CONCURRENT_SSH=1

# --- HTTP server ---
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed CORS origins. Empty = same-origin only.
ALLOWED_ORIGINS=

# --- Storage (DuckDB) ---
# Path to the DuckDB file. Empty disables storage and the API reads via SFTP only.
DB_PATH=data/zeek.duckdb
# Background ingest worker that pulls new rows into DuckDB.
INGEST_ENABLED=true
INGEST_INTERVAL=30
# Bytes pulled per ingest tick when no prior offset is known.
INGEST_TAIL_BYTES=2097152
